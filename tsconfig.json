{
  "include": ["src", "test", "scripts", "lint-staged.config.mjs"],
  "exclude": ["node_modules", "client"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "rootDir": ".",
    "target": "esnext",
    "module": "nodenext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  }
}
