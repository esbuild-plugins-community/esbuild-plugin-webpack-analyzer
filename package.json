{
  "name": "@espcom/esbuild-plugin-webpack-analyzer",
  "author": "espcom",
  "license": "MIT",
  "version": "1.1.1",
  "description": "Webpack Bundle Analyzer integration for esbuild",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esbuild-plugins-community/esbuild-plugin-webpack-analyzer.git"
  },
  "keywords": [
    "esbuild",
    "esbuild-plugin",
    "plugin",
    "analyzer",
    "bundle-size"
  ],
  "scripts": {
    "prepare": "husky",
    "prepublishOnly": "pnpm run analyze && pnpm run test",
    "clear-modules": "rm -rf ./node_modules",
    "upd": "pnpm run clear-modules && pnpm i --prefer-offline",
    "npm-publish": "pnpm run build && cd ./dist && npm publish --access public --tag latest && cd ../",
    "analyze": "biome check --no-errors-on-unmatched --write . && tsc --noEmit",
    "build": "rm -rf ./dist && tsc -b ./tsconfig.esm.json && node ./scripts/buildViewer.ts && node ./scripts/genPackageFiles.ts",
    "build-watch": "rm -rf ./dist && tsc -b ./tsconfig.esm.json --watch && node ./scripts/genPackageFiles.ts",
    "test": "pnpm run build && node --test --test-reporter=spec ./test/*.test.*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@types/node": "26.0.0",
    "esbuild": "0.28.1",
    "typescript": "7.0.1-rc",
    "husky": "9.1.7",

    "preact": "10.29.2",
    "mobx": "6.16.1",
    "@carrotsearch/foamtree": "3.6.1",
    "mobx-react": "9.2.2"
  },
  "peerDependencies": {
    "esbuild": ">=0.23"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "types": "./index.d.ts",
  "packageManager": "pnpm@8.6.3"
}
